<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>On-Device AI Model Index</title>
  <style>.filter-btn[aria-pressed="true"]{background:#000;color:#fff}</style>
  <link href="https://cdn.datatables.net/v/dt/dt-3.0.4/af-3.0.1/b-4.0.3/cr-3.0.2/cc-2.0.2/date-2.0.0/fc-6.0.0/fh-5.0.0/kt-3.0.0/r-4.0.3/rg-2.0.0/rr-2.0.0/sc-3.0.0/sb-2.0.1/sl-4.0.1/datatables.min.css" rel="stylesheet" integrity="sha384-KaNPuvSvJqdUngLoLKqaFK2ZDb2sPIRRkZA1kY2W/J5E0bKBAyLFeUXxQBREJ07E" crossorigin="anonymous">
</head>
<body>
  <h1>On-Device AI Model Index</h1>
  <p>Small AI models that run offline on phones, Raspberry Pis, laptops, and browsers. No cloud, no API keys, no network calls. A model qualifies if it (1) does something useful, (2) runs on consumer hardware without a cloud service, and (3) has a working public download.</p>
  <p><a href="https://github.com/rbk-agent/on-device-models">GitHub repository</a> · <a href="models.json">JSON index</a> · <a href="https://github.com/rbk-agent/on-device-models/blob/main/docs/model-notes.md">Long-form reference</a></p>

  <p>
    <button type="button" class="filter-btn" data-q="MIT">MIT</button>
    <button type="button" class="filter-btn" data-q="music">Music</button>
    <button type="button" class="filter-btn" data-q="bird">Birds</button>
    <button type="button" class="filter-btn" data-q="photo">Vision</button>
    <button type="button" class="filter-btn" data-q="audio">Audio</button>
    <button type="button" class="filter-btn" data-q="speech">Speech</button>
    <button type="button" class="filter-btn" data-q="apache">Apache</button>
    <button type="button" class="filter-btn" data-q="native">Node native</button>
    <button type="button" id="clear-filters">Clear</button>
  </p>

  <table id="models">
    <thead>
      <tr>
        <th>Model</th>
        <th>Category</th>
        <th>Task</th>
        <th>Input</th>
        <th>Size</th>
        <th>License</th>
        <th>Node SDK</th>
        <th class="none">Notes</th>
      </tr>
    </thead>
    <tbody>
      {%- for cat in models.categories %}
      {%- for m in cat.models %}
      {% set primary = m.links.repo or m.links.npm or m.links.hub or m.links.docs or m.links.huggingface or m.links.dataset %}
      <tr>
        <td><a href="{{ primary }}">{{ m.name }}</a></td>
        <td>{{ cat.name }}</td>
        <td>{{ m.task }}</td>
        <td>{{ m.input }}</td>
        <td>{{ m.size }}</td>
        <td>{{ m.license }}</td>
        <td>{{ m.node_sdk }}</td>
        <td class="none">
          {{ m.summary }}
          {%- if m.license_note %}<br><br>License: {{ m.license_note }}{% endif %}
          {%- if m.node_note %}<br><br>Node: {{ m.node_note }}{% endif %}
        </td>
      </tr>
      {%- endfor %}
      {%- endfor %}
    </tbody>
  </table>

  <footer>
    <p>Updated {{ models.updated }}. To add a model, edit <a href="https://github.com/rbk-agent/on-device-models/blob/main/site/src/_data/models.json">site/src/_data/models.json</a> — the site builds from it.</p>
  </footer>

  <script src="https://cdn.datatables.net/v/dt/dt-3.0.4/af-3.0.1/b-4.0.3/cr-3.0.2/cc-2.0.2/date-2.0.0/fc-6.0.0/fh-5.0.0/kt-3.0.0/r-4.0.3/rg-2.0.0/rr-2.0.0/sc-3.0.0/sb-2.0.1/sl-4.0.1/datatables.min.js" integrity="sha384-sXe6a656KBCTGQSil4v+EfXtoqhkcvZBWgCCG2eIfN4WLZqkokebD55EhHwY+4h5" crossorigin="anonymous"></script>
  <script>
    const table = new DataTable('#models', {
      paging: false,
      responsive: true,
      order: [[1, 'asc'], [0, 'asc']]
    });

    // The search box is the source of truth. Toggles add/remove their term;
    // the URL hash mirrors the box so filtered views are shareable.
    const input = document.querySelector('#models_filter input, input[type=search]');

    const setSearch = (q, push) => {
      input.value = q;
      const url = q ? '#' + encodeURIComponent(q) : location.pathname + location.search;
      push ? history.pushState(null, '', url) : history.replaceState(null, '', url);
      table.search(q).draw();
      refreshButtons();
    };
    const refreshButtons = () => {
      const terms = input.value.toLowerCase().split(/\s+/).filter(Boolean);
      document.querySelectorAll('.filter-btn').forEach((btn) => {
        btn.setAttribute('aria-pressed', terms.includes(btn.dataset.q.toLowerCase()) ? 'true' : 'false');
      });
    };

    // Button clicks toggle their term and add a history entry (Back/Forward walks views)
    document.querySelectorAll('.filter-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const q = btn.dataset.q;
        const terms = input.value.split(/\s+/).filter(Boolean);
        const i = terms.findIndex((t) => t.toLowerCase() === q.toLowerCase());
        i === -1 ? terms.push(q) : terms.splice(i, 1);
        setSearch(terms.join(' '), true);
      });
    });
    document.getElementById('clear-filters').addEventListener('click', () => setSearch('', true));

    // Typing replaces history (no keystroke spam); stale toggle states clear themselves
    input.addEventListener('input', () => setSearch(input.value, false));

    // Back/forward between filtered views: read the hash, don't write history
    window.addEventListener('hashchange', () => {
      input.value = decodeURIComponent(location.hash.slice(1));
      table.search(input.value).draw();
      refreshButtons();
    });

    // Deep link on load: #bird%20music
    input.value = decodeURIComponent(location.hash.slice(1));
    table.search(input.value).draw();
    refreshButtons();
  </script>
</body>
</html>