---
permalink: index.html
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>On-Device AI Model Index</title>
</head>
<body>
  <h1>On-Device AI Model Index</h1>
  <p>Small AI models that run offline on phones, Raspberry Pis, laptops, and browsers. No cloud, no API keys, no network calls. A model qualifies if it (1) does something useful, (2) runs on consumer hardware without a cloud service, and (3) has a working public download.</p>
  <p><a href="https://github.com/rbk-agent/on-device-models">GitHub repository</a> · <a href="models.json">JSON index</a> · <a href="https://github.com/rbk-agent/on-device-models/blob/main/docs/model-notes.md">Long-form reference</a></p>

  <nav>
    <h2>Categories</h2>
    <ol>
      {%- for cat in models.categories %}
      <li><a href="#{{ cat.id }}">{{ cat.name }}</a></li>
      {%- endfor %}
    </ol>
  </nav>

  <main>
    {%- for cat in models.categories %}
    <section id="{{ cat.id }}">
      <h2>{{ cat.name }}</h2>
      {% if cat.blurb %}<p>{{ cat.blurb }}</p>{% endif %}
      <ul>
        {%- for m in cat.models %}
        {% set primary = m.links.repo or m.links.npm or m.links.hub or m.links.docs or m.links.huggingface %}
        <li>
          <strong><a href="{{ primary }}">{{ m.name }}</a></strong> — {{ m.task }}
          <br>
          <small>{{ m.input }} · {{ m.size }} · {{ m.license }} · Node SDK: {{ m.node_sdk }}</small>
          <br>
          {{ m.summary }}
          {% if m.license_note %}<br><small>License note: {{ m.license_note }}</small>{% endif %}
          {% if m.node_note %}<br><small>Node: {{ m.node_note }}</small>{% endif %}
        </li>
        {%- endfor %}
      </ul>
    </section>
    {%- endfor %}
  </main>

  <footer>
    <p>Updated {{ models.updated }}. To add a model, edit <a href="https://github.com/rbk-agent/on-device-models/blob/main/site/src/_data/models.json">site/src/_data/models.json</a> — the site builds from it.</p>
  </footer>
</body>
</html>